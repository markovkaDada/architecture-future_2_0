        [Cloud Data Platforms]
        [Kubernetes]
        [Apache Kafka]
        [Docker]
    }

    rectangle "TRIAL" #yellow {
        [Data Mesh Platform]
        [Snowflake/BigQuery]
        [Apache Airflow]
    }

    rectangle "ASSESS" #lightblue {
        [Databricks]
        [dbt Cloud]
        [Confluent Platform]
    }

    rectangle "HOLD" #lightcoral {
